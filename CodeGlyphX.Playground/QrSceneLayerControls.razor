@using CodeGlyphX.Rendering.Art

<details class="scene-layer" open="@IsQr">
    <summary>@Name</summary>
    @if (!IsQr)
    {
        <label><input type="checkbox" @bind="_local.Visible" @bind:after="Notify" /> Show @Name.ToLowerInvariant()</label>
    }
    <label>Horizontal center · @_local.X.ToString("P0") <input type="range" min="0" max="1" step="0.01" @bind="_local.X" @bind:after="Notify" /></label>
    <label>Vertical center · @_local.Y.ToString("P0") <input type="range" min="0" max="1" step="0.01" @bind="_local.Y" @bind:after="Notify" /></label>
    <label>Scale · @_local.Scale.ToString("F2") <input type="range" min="@(IsQr ? "0.25" : "0.05")" max="@(IsQr ? "0.8" : "2")" step="0.01" @bind="_local.Scale" @bind:after="Notify" /></label>
    <label>Rotation · @_local.RotationDegrees.ToString("F0")° <input type="range" min="0" max="@(IsQr ? 270 : 360)" step="@(IsQr ? 90 : 5)" @bind="_local.RotationDegrees" @bind:after="Notify" /></label>
</details>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public QrSceneLayerOptions Settings { get; set; } = new();
    [Parameter] public EventCallback<QrSceneLayerOptions> SettingsChanged { get; set; }
    [Parameter] public bool IsQr { get; set; }
    private QrSceneLayerOptions _local = new();
    protected override void OnParametersSet() => _local = Copy(Settings);
    private Task Notify() => SettingsChanged.InvokeAsync(Copy(_local));
    private static QrSceneLayerOptions Copy(QrSceneLayerOptions value) => new() { Visible = value.Visible, X = value.X, Y = value.Y, Scale = value.Scale, RotationDegrees = value.RotationDegrees };
}
