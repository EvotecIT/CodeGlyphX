@using CodeGlyphX
@using CodeGlyphX.Payloads
@using CodeGlyphX.DataMatrix
@using CodeGlyphX.Pdf417
@using CodeGlyphX.Aztec
@using CodeGlyphX.Rendering
@using CodeGlyphX.Rendering.Png
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Host is null)
{
    <div class="card">
        <h2>Configuration</h2>
        <p>Loading...</p>
    </div>
}
else
{
    <div class="card">
        <h2>Configuration</h2>

        <div class="form-group">
            <label>Mode</label>
            <select @bind="Host.SelectedMode" @bind:after="Host.OnModeChanged">
                <option value="Generate">Generate</option>
                <option value="Decode">Decode</option>
            </select>
        </div>

        @if (Host.SelectedMode == "Decode")
        {
            <div class="form-group">
                <label>Image File</label>
                <label class="dropzone @(Host.IsDropActive ? "active" : string.Empty)"
                       @ref="_dropZoneRef"
                       @ondragenter="Host.OnDragEnter"
                       @ondragleave="Host.OnDragLeave">
                    <InputFile @ref="_inputFileRef"
                               OnChange="Host.OnDecodeFileChanged"
                               accept="image/*"
                               style="position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;" />
                    <div class="dropzone-inner">
                        <strong>Drop an image here</strong>
                        <span>or click to select</span>
                    </div>
                </label>
                <small class="form-hint">Supports PNG, JPEG, GIF, BMP, TIFF, PPM/PBM/PGM/PAM, XBM/XPM, TGA, ICO.</small>
            </div>

            <div class="form-group">
                <label>Decode quality</label>
                <select @bind="Host.DecodeQualityPreset" @bind:after="Host.ApplyDecodePreset">
                    <option value="Speed">Speed</option>
                    <option value="Balanced">Balanced</option>
                    <option value="Quality">Quality</option>
                    <option value="Custom">Custom</option>
                </select>
                <small class="form-hint">Use Quality for large or artistic codes.</small>
            </div>

            <div class="form-group">
                <label>Decode Options</label>
                <div class="form-row">
                    <label><input type="checkbox" @bind="Host.DecodeDownscale" @bind:after="Host.MarkDecodePresetCustom" /> Downscale large images</label>
                    <label><input type="checkbox" @bind="Host.DecodeStopAfterFirst" @bind:after="Host.MarkDecodePresetCustom" /> Stop after first match</label>
                </div>
            </div>

            <div class="form-group">
                <label>Max dimension (px): @Host.DecodeMaxDimension</label>
                <input type="range" min="512" max="4096" step="256" @bind="Host.DecodeMaxDimension" @bind:after="Host.MarkDecodePresetCustom" />
            </div>

            <div class="form-group">
                <label>Total decode budget (ms): @Host.DecodeBudgetMilliseconds</label>
                <input type="range" min="200" max="10000" step="250" @bind="Host.DecodeBudgetMilliseconds" @bind:after="Host.MarkDecodePresetCustom" />
            </div>

            <div class="form-group">
                <label>Try Decode</label>
                <div class="form-row">
                    <label><input type="checkbox" @bind="Host.DecodeQr" /> QR</label>
                    <label><input type="checkbox" @bind="Host.DecodeBarcode" /> 1D Barcodes</label>
                    <label><input type="checkbox" @bind="Host.DecodeMatrix" /> 2D Matrix</label>
                </div>
                <details style="margin-top:8px;">
                    <summary>Advanced formats</summary>
                    <label><input type="checkbox" @bind="Host.DecodeIncludeAmbiguousFormats" /> Include Pharmacode and PatchCode</label>
                    <small class="form-hint">These formats can match unrelated patterns. Enable them only when you expect them in the image.</small>
                </details>
                @if (Host.IsDecoding)
                {
                    <div class="form-row" style="margin-top:8px;">
                        <small>@Host.DecodeStatus</small>
                        <button type="button" class="preset-btn" @onclick="Host.CancelDecode">Cancel</button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="form-group">
                <label>Presets</label>
                <div class="preset-grid">
                    <button type="button" class="preset-btn" @onclick="@(() => Host.ApplyPreset("QrUrl"))">QR URL</button>
                    <button type="button" class="preset-btn" @onclick="@(() => Host.ApplyPreset("QrWifi"))">WiFi</button>
                    <button type="button" class="preset-btn" @onclick="@(() => Host.ApplyPreset("QrOtp"))">OTP</button>
                    <button type="button" class="preset-btn" @onclick="@(() => Host.ApplyPreset("BarcodeEan"))">EAN-13</button>
                    <button type="button" class="preset-btn" @onclick="@(() => Host.ApplyPreset("BarcodeCode128"))">Code 128</button>
                    <button type="button" class="preset-btn" @onclick="@(() => Host.ApplyPreset("MatrixPdf417"))">PDF417</button>
                    <button type="button" class="preset-btn" @onclick="@(() => Host.ApplyPreset("MatrixDataMatrix"))">Data Matrix</button>
                    <button type="button" class="preset-btn" @onclick="@(() => Host.ApplyPreset("MatrixAztec"))">Aztec</button>
                </div>
            </div>

            <div class="form-group">
                <label>Code Type</label>
                <select @bind="Host.SelectedCategory" @bind:after="Host.OnCategoryChanged">
                    <option value="QR">QR Code</option>
                    <option value="SpecialQR">Special QR Codes</option>
                    <option value="Barcode">1D Barcodes</option>
                    <option value="Matrix">2D Matrix Codes</option>
                </select>
            </div>

            @if (Host.IsQr)
            {
                <div class="form-group design-choice">
                    <label for="qr-design">QR design</label>
                    <select id="qr-design" @bind="Host.QrDesign" @bind:after="Host.GenerateCode">
                        <option value="Styled">Colors and shapes</option>
                        <option value="Artwork" disabled="@(!Host.ArtworkAvailable)">Artwork and scenes</option>
                    </select>
                    <small class="form-hint">@(Host.ArtworkAvailable ? "Both designs use the data below. Switch designs at any time." : "Girocode keeps its payment encoding and error correction. Artwork comparison is unavailable for this payload.")</small>
                </div>
            }

            @if (Host.SelectedCategory == "QR")
            {
                @* Basic Settings - Always expanded by default (see _basicOpen = true in @code) *@
                <AccordionSection Title="Basic Settings" @bind-IsOpen="_basicOpen">
                    <div class="form-group">
                        <label>Content</label>
                        <textarea rows="3" @bind="Host.Content" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" placeholder="Enter text, URL, or data..."></textarea>
                    </div>

                    @if (!Host.IsArtwork) {
                    <div class="form-group">
                        <label>Error Correction Level</label>
                        <select @bind="Host.ErrorCorrection" @bind:after="Host.GenerateCode">
                            <option value="L">L - Low (7% recovery)</option>
                            <option value="M">M - Medium (15% recovery)</option>
                            <option value="Q">Q - Quartile (25% recovery)</option>
                            <option value="H">H - High (30% recovery)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Output Size</label>
                        <select @bind="Host.OutputSizePreset" @bind:after="Host.OnOutputSizePresetChanged">
                            <option value="Auto">Auto</option>
                            <option value="1200">1200 px</option>
                            <option value="2400">2400 px</option>
                            <option value="4000">4000 px</option>
                            <option value="8000">8000 px</option>
                            <option value="Custom">Custom</option>
                        </select>
                        @if (Host.OutputSizePreset == "Custom")
                        {
                            <div class="form-row" style="margin-top:8px;">
                                <label>Target px</label>
                                <input type="number" min="200" max="12000" step="50" @bind="Host.TargetSizePx" @bind:after="Host.GenerateCode" />
                            </div>
                        }
                        <div class="form-row" style="margin-top:8px;">
                            <label><input type="checkbox" @bind="Host.TargetSizeIncludesQuietZone" @bind:after="Host.GenerateCode" /> Include quiet zone</label>
                        </div>
                    </div>
                    }
                </AccordionSection>

            }
            else if (Host.SelectedCategory == "SpecialQR")
            {
                <div class="form-group">
                    <label>Type</label>
                    <select @bind="Host.SpecialPayloadType" @bind:after="Host.GenerateCode">
                        <option value="WiFi">WiFi</option>
                        <option value="vCard">vCard</option>
                        <option value="Email">Email</option>
                        <option value="Phone">Phone</option>
                        <option value="SMS">SMS</option>
                        <option value="URL">URL</option>
                        <option value="OTP">OTP</option>
                        <option value="Girocode">Girocode</option>
                    </select>
                </div>

                @if (Host.SpecialPayloadType == "WiFi")
                {
                    <div class="form-group">
                        <label>SSID</label>
                        <input type="text" @bind="Host.WifiSsid" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="text" @bind="Host.WifiPassword" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Security</label>
                        <select @bind="Host.WifiSecurity" @bind:after="Host.GenerateCode">
                            <option value="WPA">WPA/WPA2</option>
                            <option value="WEP">WEP</option>
                            <option value="None">None</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label><input type="checkbox" @bind="Host.WifiHidden" @bind:after="Host.GenerateCode" /> Hidden network</label>
                    </div>
                }
                else if (Host.SpecialPayloadType == "vCard")
                {
                    <div class="form-group">
                        <label>First name</label>
                        <input type="text" @bind="Host.VCardFirstName" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Last name</label>
                        <input type="text" @bind="Host.VCardLastName" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Phone</label>
                        <input type="text" @bind="Host.VCardPhone" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="text" @bind="Host.VCardEmail" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Website</label>
                        <input type="text" @bind="Host.VCardWebsite" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Organization</label>
                        <input type="text" @bind="Host.VCardOrganization" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                }
                else if (Host.SpecialPayloadType == "Email")
                {
                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" @bind="Host.EmailAddress" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Subject</label>
                        <input type="text" @bind="Host.EmailSubject" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Body</label>
                        <textarea rows="2" @bind="Host.EmailBody" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync"></textarea>
                    </div>
                }
                else if (Host.SpecialPayloadType == "Phone")
                {
                    <div class="form-group">
                        <label>Phone number</label>
                        <input type="text" @bind="Host.PhoneNumber" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                }
                else if (Host.SpecialPayloadType == "SMS")
                {
                    <div class="form-group">
                        <label>Number</label>
                        <input type="text" @bind="Host.SmsNumber" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Message</label>
                        <textarea rows="2" @bind="Host.SmsMessage" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync"></textarea>
                    </div>
                }
                else if (Host.SpecialPayloadType == "URL")
                {
                    <div class="form-group">
                        <label>URL</label>
                        <input type="text" @bind="Host.UrlContent" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                }
                else if (Host.SpecialPayloadType == "OTP")
                {
                    <div class="form-group">
                        <label>Type</label>
                        <select @bind="Host.OtpType" @bind:after="Host.GenerateCode">
                            <option value="TOTP">TOTP</option>
                            <option value="HOTP">HOTP</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Secret</label>
                        <input type="text" @bind="Host.OtpSecret" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Label</label>
                        <input type="text" @bind="Host.OtpLabel" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Issuer</label>
                        <input type="text" @bind="Host.OtpIssuer" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                }
                else if (Host.SpecialPayloadType == "Girocode")
                {
                    <div class="form-group">
                        <label>IBAN</label>
                        <input type="text" @bind="Host.GirocodeIban" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>BIC</label>
                        <input type="text" @bind="Host.GirocodeBic" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Recipient</label>
                        <input type="text" @bind="Host.GirocodeRecipient" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>Amount</label>
                        <input type="number" step="0.01" @bind="Host.GirocodeAmount" @bind:after="Host.GenerateCode" />
                    </div>
                    <div class="form-group">
                        <label>Reference</label>
                        <input type="text" @bind="Host.GirocodeReference" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                }
            }
            else if (Host.SelectedCategory == "Barcode")
            {
                <div class="form-group">
                    <label>Barcode Type</label>
                    <select @bind="Host.SelectedBarcodeType" @bind:after="Host.OnBarcodeTypeChanged">
                        <option value="Code128">Code 128</option>
                        <option value="GS1128">GS1-128</option>
                        <option value="Code39">Code 39</option>
                        <option value="Code93">Code 93</option>
                        <option value="Code11">Code 11</option>
                        <option value="Codabar">Codabar</option>
                        <option value="MSI">MSI</option>
                        <option value="Plessey">Plessey</option>
                        <option value="Telepen">Telepen</option>
                        <option value="EAN">EAN-13</option>
                        <option value="UPCA">UPC-A</option>
                        <option value="UPCE">UPC-E</option>
                        <option value="ITF14">ITF-14</option>
                        <option value="ITF">ITF (Interleaved 2 of 5)</option>
                        <option value="Code32">Code 32 (Italian Pharma)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>@Host.GetBarcodeContentLabel()</label>
                    <input type="text" @bind="Host.BarcodeContent" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" placeholder="@Host.GetBarcodeContentPlaceholder()" />
                    @if (!string.IsNullOrEmpty(Host.BarcodeHint))
                    {
                        <small class="form-hint">@Host.BarcodeHint</small>
                    }
                </div>
            }
            else if (Host.SelectedCategory == "Matrix")
            {
                <div class="form-group">
                    <label>Matrix Type</label>
                    <select @bind="Host.SelectedMatrixType" @bind:after="Host.GenerateCode">
                        <option value="DataMatrix">Data Matrix</option>
                        <option value="Pdf417">PDF417</option>
                        <option value="Aztec">Aztec</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Content</label>
                    <textarea rows="3" @bind="Host.MatrixContent" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync"></textarea>
                </div>

                @if (Host.SelectedMatrixType == "DataMatrix")
                {
                    <div class="form-group">
                        <label>Encoding Mode</label>
                        <select @bind="Host.SelectedDataMatrixMode" @bind:after="Host.GenerateCode">
                            <option value="Auto">Auto</option>
                            <option value="Ascii">ASCII</option>
                            <option value="C40">C40</option>
                            <option value="Text">Text</option>
                            <option value="X12">X12</option>
                            <option value="Edifact">Edifact</option>
                            <option value="Base256">Base256</option>
                        </select>
                    </div>
                }
                else if (Host.SelectedMatrixType == "Pdf417")
                {
                    <div class="form-group">
                        <label>Error Correction: @Host.Pdf417EccLevel</label>
                        <input type="range" min="-1" max="8" step="1" @bind="Host.Pdf417EccLevel" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="Host.Pdf417Compact" @bind:after="Host.GenerateCode" />
                            Compact PDF417
                        </label>
                    </div>
                }
                else if (Host.SelectedMatrixType == "Aztec")
                {
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="Host.AztecAutoEcc" @bind:after="Host.GenerateCode" />
                            Auto error correction
                        </label>
                    </div>
                    <div class="form-group">
                        <label>Error Correction %: @Host.AztecEccPercent</label>
                        <input type="range" min="5" max="50" step="1" @bind="Host.AztecEccPercent" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" disabled="@Host.AztecAutoEcc" />
                    </div>
                    <div class="form-group">
                        <label>Layers (0 = auto): @Host.AztecLayers</label>
                        <input type="range" min="0" max="32" step="1" @bind="Host.AztecLayers" @bind:event="oninput" @bind:after="Host.QueueGenerateAsync" />
                    </div>
                }
            }

            @if (Host.IsQr)
            {
                @if (!Host.IsArtwork) { <PlaygroundQrAppearance /> }
                <div hidden="@(!Host.IsArtwork)">
                    <QrArtStudio @ref="Host.ArtEditor" />
                </div>
            }

            <button class="btn btn-primary" style="width: 100%; margin-top: 1.5rem;" @onclick="Host.GenerateCode">
                @(Host.IsArtwork ? "Update design" : "Generate Code")
            </button>
        }
    </div>
}

@code {
    [CascadingParameter]
    public Playground? Host { get; set; }

    // Accordion state - Basic Settings starts open
    private bool _basicOpen = true;

    // Drop zone references
    private ElementReference _dropZoneRef;
    private InputFile? _inputFileRef;
    private IJSObjectReference? _dropZoneInstance;
    private bool _dropZoneInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Host?.SelectedMode == "Decode" && !_dropZoneInitialized && _inputFileRef is not null)
        {
            _dropZoneInitialized = true;
            try
            {
                _dropZoneInstance = await JS.InvokeAsync<IJSObjectReference>(
                    "CodeGlyphX.setupDropZone",
                    _dropZoneRef,
                    _inputFileRef.Element);
            }
            catch
            {
                // JS interop may fail during prerendering
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dropZoneInstance is not null)
        {
            try
            {
                await _dropZoneInstance.InvokeVoidAsync("dispose");
                await _dropZoneInstance.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
        }
    }
}
