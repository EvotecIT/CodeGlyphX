@using CodeGlyphX

<div class="playground">
    <h1>Code configurator</h1>
    <p class="playground-subtitle">
        Create a QR code, style it, or turn it into artwork. One set of data, one preview. Everything runs locally in your browser.
    </p>

    <CascadingValue Value="this">
        <div class="playground-grid">
            <div class="playground-config-column">
                <PlaygroundConfig />
            </div>
            <div class="playground-preview-column">
                <PlaygroundPreview />
            </div>
        </div>

        @if (!IsArtwork) { <PlaygroundExample @key="_exampleKey" /> }
        <PlaygroundFooter />
    </CascadingValue>
</div>
