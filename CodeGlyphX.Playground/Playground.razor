@using CodeGlyphX

<div class="playground">
    <CascadingValue Value="this">
        <div class="playground-grid">
            <div class="playground-config-column">
                <PlaygroundConfig />
            </div>
            <div class="playground-preview-column">
                <PlaygroundPreview />
            </div>
        </div>

        @if (!IsArtwork) { <PlaygroundExample @key="_exampleKey" /> }
        @if (SelectedMode == "Generate" && !IsArtwork) { <BarcodePrintStudio /> }
        <PlaygroundFooter />
    </CascadingValue>
</div>
