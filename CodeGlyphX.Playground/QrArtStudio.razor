@using CodeGlyphX.Rendering.Art
@implements IDisposable

<section class="art-studio" aria-labelledby="art-title">
    <header><p class="art-eyebrow">COLOR + GEOMETRY + CODE</p><h2 id="art-title">QR art studio</h2>
        <p>Create a colorful pattern or bring your own image. Shape the artwork, compare alternatives and check the final export. Everything runs locally in your browser.</p></header>
    <div class="art-workspace">
        <div class="art-controls">
            <fieldset disabled="@(_busy || _loading)">
                <legend>Artwork and color</legend>
                <label>Artwork source <select @bind="_sourceKind" @bind:after="ChangeSource">
                    <option value="pattern">Procedural pattern</option><option value="image">Uploaded image</option>
                </select></label>
                @if (_procedural)
                {
                    <QrPatternControls Settings="_patternSettings" SettingsChanged="ChangePattern" />
                }
                else
                {
                    <label>Image <InputFile OnChange="LoadImage" accept="image/*" /></label>
                    <p class="art-hint">Uploads stay in this browser. Default photo: NASA / Apollo 17.</p>
                }
                <label>QR text <textarea @bind="_payload" rows="2" maxlength="1000"></textarea></label>
                <details class="art-layout"><summary>QR treatment and frame</summary>
                <label>Treatment <select @bind="_style">
                    @foreach (var style in Enum.GetValues<QrImageArtStyle>())
                    {
                        <option value="@style">@StyleName(style)</option>
                    }
                </select></label>
                <label>Color strength · @_strength.ToString("F2") <input type="range" min="0" max="1" step="0.01" @bind="_strength" /></label>
                <label>Module scale · @_artScale.ToString("F2") <input type="range" min="0.65" max="1" step="0.05" @bind="_artScale" /></label>
                <label>Detail protection · @_detail.ToString("F2") <input type="range" min="0" max="1" step="0.05" @bind="_detail" /></label>
                <label>Export pixels per module <input type="number" min="6" max="64" @bind="_moduleSize" /></label>
                <label>Finder frames <select @bind="_finders">
                    @foreach (var finder in Enum.GetValues<QrImageFinderStyle>())
                    {
                        <option value="@finder">@finder</option>
                    }
                </select></label>
                <label><input type="checkbox" @bind="_frameEnabled" @bind:after="ApplyIllustration" /> Illustrated composition</label>
                @if (_frameEnabled)
                {
                    <label>Composition family <select @bind="_frameStyle" @bind:after="ApplyIllustration">
                        @foreach (var frame in Enum.GetValues<QrIllustratedStyle>())
                        {
                            <option value="@frame">@FamilyName(frame)</option>
                        }
                    </select></label>
                    <p class="art-hint">SVG exports keep the frame as vectors and embed the QR artwork at its rendered resolution.</p>
                }
                <label><input type="checkbox" @bind="_exploreLayouts" /> Compare crop, placement and scale variations</label>
                @if (!_procedural)
                {
                    <label><input type="checkbox" @bind="_protect" /> Preserve a subject region</label>
                    @if (_protect)
                    {
                        <label>Subject horizontal position <input type="range" min="0" max="1" step="0.01" @bind="_subjectX" /></label>
                        <label>Subject vertical position <input type="range" min="0" max="1" step="0.01" @bind="_subjectY" /></label>
                        <label>Subject radius <input type="range" min="0.05" max="0.7" step="0.01" @bind="_radius" /></label>
                        <label>Protection mask (optional) <InputFile OnChange="LoadMask" accept="image/*" /></label>
                        <p class="art-hint">White protects detail; black permits decoration. The mask follows the source image crop.</p>
                        @if (_mask is not null)
                        {
                            <button type="button" @onclick="ClearMask">Clear mask</button>
                        }
                    }
                }
                <details class="art-layout"><summary>Crop and placement</summary>
                <label>Image horizontal crop <input type="range" min="0" max="1" step="0.01" @bind="_cropX" /></label>
                <label>Image vertical crop <input type="range" min="0" max="1" step="0.01" @bind="_cropY" /></label>
                <label>Image zoom <input type="range" min="1" max="3" step="0.05" @bind="_zoom" /></label>
                <label>QR horizontal placement <input type="range" min="0" max="1" step="0.01" @bind="_qrX" /></label>
                <label>QR vertical placement <input type="range" min="0" max="1" step="0.01" @bind="_qrY" /></label>
                </details>
                </details>
            </fieldset>
            <div class="art-actions"><button type="button" class="art-primary" disabled="@(_busy || _loading || _source is null)" @onclick="Compare">Compare alternatives</button>
                @if (_busy)
                {
                    <button type="button" @onclick="Cancel">Cancel</button>
                }
            </div>
            <p role="status" aria-live="polite">@_status</p>
            @if (_error is not null)
            {
                <p role="alert" class="art-error">@_error</p>
            }
        </div>
        <div class="art-results">
            @if (_sourceUri is not null)
            {
                <figure class="art-source"><div class="art-source-frame"><img src="@_sourceUri" alt="Source artwork" />
                    @if (!_procedural && _protect && _mask is null)
                    {
                        <span class="art-focal" style="@FocalStyle" aria-hidden="true"></span>
                    }
                </div><figcaption>@(_procedural ? $"{QrPatternControls.Name(_patternSettings.Pattern)} · seed {_patternSettings.Seed}" : "Source artwork · focal region shown on the original image")</figcaption></figure>
            }
            @if (_result is not null)
            {
                <p class="art-result-label">Last comparison: @_resultDescription. Editing controls leaves these exports available until the next comparison.</p>
                <p>@_result.EvaluatedCandidates combinations compared · @_result.ValidatedCandidates alternatives decoded. Scan results rank first, then @(_cards.Any(card => card.SvgUri is not null) ? "unframed artwork fidelity" : "source fidelity").</p>
                <div class="art-candidates">
                    @foreach (var item in _cards)
                    {
                        <QrArtCandidateCard @key="item" Card="item" Busy="@(_busy || _loading)" OnDeliveryCheck="CheckDelivery" />
                    }
                </div>
                <fieldset disabled="@(_busy || _loading)" class="art-delivery"><legend>Delivery simulations</legend>
                    <label>Screen size (px) <input type="number" min="32" max="2048" @bind="_screenSize" /></label>
                    <label>Print width (mm) <input type="number" min="5" max="100" @bind="_printMm" /></label>
                    <label>Print resolution (DPI) <input type="number" min="72" max="300" @bind="_dpi" /></label>
                </fieldset>
                <p class="art-hint">Checks cover the original, half-size, blur, screen size, print raster, JPEG and perspective. A failed check may indicate insufficient contrast, size or decode time. Test the final printed asset with real phones before distribution.</p>
            }
            else
            {
                <p class="art-empty">Choose a pattern or image and compare alternatives. Functional QR patterns and the quiet zone remain protected.</p>
            }
        </div>
    </div>
</section>
