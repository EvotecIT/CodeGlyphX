@using CodeGlyphX
@inject IJSRuntime JS

@if (Host is null)
{
    <div class="card" style="margin-top: 2rem;">
        <h2>Code Example</h2>
        <p>Loading...</p>
    </div>
}
else
{
    <div class="card" style="margin-top: 2rem;">
        <h2>Code Example</h2>
        <p class="pg-example-intro">
            @if (IsPowerShell)
            {
                <text>Run the same code from PowerShell with the <a href="https://www.powershellgallery.com/packages/ImagePlayground" target="_blank" rel="noopener">ImagePlayground</a> module, which is built on CodeGlyphX:</text>
            }
            else
            {
                <text>Start with this example in your .NET application, then apply the additional styling options you need:</text>
            }
        </p>

        <div class="code-tabs" role="group" aria-label="Platform">
            @foreach (var (value, label) in Platforms)
            {
                <button type="button" class="code-tab @(SelectedPlatform == value ? "active" : "")" aria-pressed="@(SelectedPlatform == value ? "true" : "false")" @onclick="@(() => SetPlatform(value))">@label</button>
            }
        </div>

        @if (!IsPowerShell)
        {
            <div class="code-tabs" role="group" aria-label="Language">
                <button type="button" class="code-tab @(SelectedLanguage == Playground.CodeLanguage.CSharp ? "active" : "")" aria-pressed="@(SelectedLanguage == Playground.CodeLanguage.CSharp ? "true" : "false")" @onclick="@(() => SetLanguage(Playground.CodeLanguage.CSharp))">C#</button>
                <button type="button" class="code-tab @(SelectedLanguage == Playground.CodeLanguage.Vb ? "active" : "")" aria-pressed="@(SelectedLanguage == Playground.CodeLanguage.Vb ? "true" : "false")" @onclick="@(() => SetLanguage(Playground.CodeLanguage.Vb))">VB.NET</button>
            </div>
        }

        <figure class="pg-code">
            <figcaption><i class="pg-code__dot @(IsPowerShell ? "pg-code__dot--ps" : string.Empty)" aria-hidden="true"></i>@GetExampleFileName()</figcaption>
            <pre class="code-block @GetLanguageCssClass()" @key="@_codeBlockKey">@GetPlatformExample()</pre>
        </figure>
    </div>
}

@code {
    [CascadingParameter]
    public Playground? Host { get; set; }

    private int _codeBlockKey = 0;

    private void SetPlatform(string platform)
    {
        SelectedPlatform = platform;
        _codeBlockKey++; // Force new element to avoid JS-modified DOM conflicts
        StateHasChanged();
    }

    private void SetLanguage(Playground.CodeLanguage language)
    {
        SelectedLanguage = language;
        _codeBlockKey++; // Force new element to avoid JS-modified DOM conflicts
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("CodeGlyphX.initCodeBlocks");
    }

    private string GetPlatformExample()
    {
        if (Host is null) return "";

        if (IsPowerShell) return GetPowerShellExample();

        var baseCode = Host.GetCodeExample(SelectedLanguage);

        return SelectedPlatform switch
        {
            "AspNet" => GetAspNetExample(SelectedLanguage, baseCode),
            "Blazor" => GetBlazorExample(SelectedLanguage, baseCode),
            "Maui" => GetMauiExample(SelectedLanguage, baseCode),
            _ => baseCode
        };
    }

    private string GetAspNetExample(Playground.CodeLanguage language, string baseCode)
    {
        if (Host?.SelectedMode == "Decode")
        {
            if (language == Playground.CodeLanguage.Vb)
            {
                return baseCode;
            }
        }
        else if (language == Playground.CodeLanguage.Vb)
        {
            return GetAspNetExampleVb();
        }
        var nl = "\n";

        if (Host?.SelectedMode == "Decode")
        {
            return "// ASP.NET Core - Decode uploaded image" + nl
                + "[HttpPost(\"decode\")]" + nl
                + "public IActionResult DecodeImage(IFormFile file)" + nl
                + "{" + nl
                + "    using var ms = new MemoryStream();" + nl
                + "    file.CopyTo(ms);" + nl
                + "    var bytes = ms.ToArray();" + nl + nl
                + "    if (QrImageDecoder.TryDecodeImage(bytes, out var result))" + nl
                + "    {" + nl
                + "        return Ok(new { Text = result.Text });" + nl
                + "    }" + nl + nl
                + "    return BadRequest(\"No code found in image\");" + nl
                + "}";
        }

        var category = Host?.SelectedCategory ?? "QR";

        if (category == "QR" || category == "SpecialQR")
        {
            return "using CodeGlyphX;" + nl
                + "using CodeGlyphX.Rendering;" + nl + nl
                + "// ASP.NET Core Minimal API endpoint" + nl
                + "app.MapGet(\"/qr\", () =>" + nl
                + "{" + nl
                + "    var png = QR.Render(\"" + EscapeForComment(Host?.Content ?? "https://example.com") + "\", OutputFormat.Png).ToArray();" + nl
                + "    return Results.File(png, \"image/png\", \"qrcode.png\");" + nl
                + "});" + nl + nl
                + "// Or in a Controller" + nl
                + "[HttpGet(\"qr/{text}\")]" + nl
                + "public IActionResult GetQrCode(string text)" + nl
                + "{" + nl
                + "    var png = QR.Render(text, OutputFormat.Png).ToArray();" + nl
                + "    return File(png, \"image/png\");" + nl
                + "}";
        }
        else if (category == "Barcode")
        {
            return "using CodeGlyphX;" + nl
                + "using CodeGlyphX.Rendering;" + nl + nl
                + "// ASP.NET Core Minimal API endpoint" + nl
                + "app.MapGet(\"/barcode/{text}\", (string text) =>" + nl
                + "{" + nl
                + "    var png = Barcode.Render(SymbolFormat." + (Host?.GetBarcodeTypeEnumName() ?? "Code128") + ", text, OutputFormat.Png).ToArray();" + nl
                + "    return Results.File(png, \"image/png\", \"barcode.png\");" + nl
                + "});" + nl + nl
                + "// Or in a Controller" + nl
                + "[HttpGet(\"barcode/{text}\")]" + nl
                + "public IActionResult GetBarcode(string text)" + nl
                + "{" + nl
                + "    var png = Barcode.Render(SymbolFormat." + (Host?.GetBarcodeTypeEnumName() ?? "Code128") + ", text, OutputFormat.Png).ToArray();" + nl
                + "    return File(png, \"image/png\");" + nl
                + "}";
        }
        else
        {
            var method = Host?.SelectedMatrixType switch
            {
                "Pdf417" => "Pdf417Code",
                "Aztec" => "AztecCode",
                _ => "DataMatrixCode"
            };
            return "using CodeGlyphX;" + nl
                + "using CodeGlyphX.Rendering;" + nl + nl
                + "// ASP.NET Core Minimal API endpoint" + nl
                + "app.MapGet(\"/matrix/{text}\", (string text) =>" + nl
                + "{" + nl
                + "    var png = " + method + ".Render(text, OutputFormat.Png).ToArray();" + nl
                + "    return Results.File(png, \"image/png\", \"matrix.png\");" + nl
                + "});" + nl + nl
                + "// Or in a Controller" + nl
                + "[HttpGet(\"matrix/{text}\")]" + nl
                + "public IActionResult GetMatrix(string text)" + nl
                + "{" + nl
                + "    var png = " + method + ".Render(text, OutputFormat.Png).ToArray();" + nl
                + "    return File(png, \"image/png\");" + nl
                + "}";
        }
    }

    private string GetBlazorExample(Playground.CodeLanguage language, string baseCode)
    {
        if (Host?.SelectedMode == "Decode")
        {
            if (language == Playground.CodeLanguage.Vb)
            {
                return baseCode;
            }
        }
        else if (language == Playground.CodeLanguage.Vb)
        {
            return "// VB.NET isn't supported in Blazor components yet; showing C#." + "\n" + GetBlazorExample(Playground.CodeLanguage.CSharp, baseCode);
        }
        var nl = "\n";

        if (Host?.SelectedMode == "Decode")
        {
            return "// Blazor component with file upload for decoding" + nl
                + "@using CodeGlyphX" + nl
                + "@using Microsoft.AspNetCore.Components.Forms" + nl + nl
                + "<InputFile OnChange=\"OnFileSelected\" accept=\"image/*\" />" + nl
                + "<p>@_decodedText</p>" + nl + nl
                + "@code {" + nl
                + "    private string _decodedText = \"\";" + nl + nl
                + "    private async Task OnFileSelected(InputFileChangeEventArgs e)" + nl
                + "    {" + nl
                + "        using var ms = new MemoryStream();" + nl
                + "        await e.File.OpenReadStream().CopyToAsync(ms);" + nl
                + "        var bytes = ms.ToArray();" + nl + nl
                + "        if (QrImageDecoder.TryDecodeImage(bytes, out var result))" + nl
                + "        {" + nl
                + "            _decodedText = result.Text;" + nl
                + "        }" + nl
                + "        else" + nl
                + "        {" + nl
                + "            _decodedText = \"No code found in image\";" + nl
                + "        }" + nl
                + "    }" + nl
                + "}";
        }

        var category = Host?.SelectedCategory ?? "QR";

        if (category == "QR" || category == "SpecialQR")
        {
            return "// Blazor component with dynamic QR code" + nl
                + "@using CodeGlyphX" + nl
                + "@using CodeGlyphX.Rendering" + nl + nl
                + "<img src=\"@_qrDataUri\" alt=\"QR Code\" />" + nl + nl
                + "@code {" + nl
                + "    private string _qrDataUri = \"\";" + nl + nl
                + "    protected override void OnInitialized()" + nl
                + "    {" + nl
                + "        var png = QR.Render(\"" + EscapeForComment(Host?.Content ?? "https://example.com") + "\", OutputFormat.Png).ToArray();" + nl
                + "        _qrDataUri = $\"data:image/png;base64,{Convert.ToBase64String(png)}\";" + nl
                + "    }" + nl
                + "}";
        }
        else if (category == "Barcode")
        {
            return "// Blazor component with dynamic barcode" + nl
                + "@using CodeGlyphX" + nl
                + "@using CodeGlyphX.Rendering" + nl + nl
                + "<img src=\"@_barcodeDataUri\" alt=\"Barcode\" />" + nl + nl
                + "@code {" + nl
                + "    private string _barcodeDataUri = \"\";" + nl + nl
                + "    protected override void OnInitialized()" + nl
                + "    {" + nl
                + "        var png = Barcode.Render(SymbolFormat." + (Host?.GetBarcodeTypeEnumName() ?? "Code128") + ", \"" + EscapeForComment(Host?.BarcodeContent ?? "12345") + "\", OutputFormat.Png).ToArray();" + nl
                + "        _barcodeDataUri = $\"data:image/png;base64,{Convert.ToBase64String(png)}\";" + nl
                + "    }" + nl
                + "}";
        }
        else
        {
            var method = Host?.SelectedMatrixType switch
            {
                "Pdf417" => "Pdf417Code",
                "Aztec" => "AztecCode",
                _ => "DataMatrixCode"
            };
            return "// Blazor component with dynamic matrix code" + nl
                + "@using CodeGlyphX" + nl
                + "@using CodeGlyphX.Rendering" + nl + nl
                + "<img src=\"@_matrixDataUri\" alt=\"Matrix Code\" />" + nl + nl
                + "@code {" + nl
                + "    private string _matrixDataUri = \"\";" + nl + nl
                + "    protected override void OnInitialized()" + nl
                + "    {" + nl
                + "        var png = " + method + ".Render(\"" + EscapeForComment(Host?.MatrixContent ?? "Data") + "\", OutputFormat.Png).ToArray();" + nl
                + "        _matrixDataUri = $\"data:image/png;base64,{Convert.ToBase64String(png)}\";" + nl
                + "    }" + nl
                + "}";
        }
    }

    private string GetMauiExample(Playground.CodeLanguage language, string baseCode)
    {
        if (Host?.SelectedMode == "Decode")
        {
            if (language == Playground.CodeLanguage.Vb)
            {
                return baseCode;
            }
        }
        else if (language == Playground.CodeLanguage.Vb)
        {
            return GetMauiExampleVb();
        }
        var nl = "\n";

        if (Host?.SelectedMode == "Decode")
        {
            return "// .NET MAUI - Decode image from file picker" + nl
                + "using CodeGlyphX;" + nl + nl
                + "// In your ViewModel or code-behind:" + nl
                + "async Task PickAndDecodeAsync()" + nl
                + "{" + nl
                + "    var result = await FilePicker.PickAsync(new PickOptions" + nl
                + "    {" + nl
                + "        FileTypes = FilePickerFileType.Images," + nl
                + "        PickerTitle = \"Select an image to decode\"" + nl
                + "    });" + nl + nl
                + "    if (result is null) return;" + nl + nl
                + "    using var stream = await result.OpenReadAsync();" + nl
                + "    using var ms = new MemoryStream();" + nl
                + "    await stream.CopyToAsync(ms);" + nl
                + "    var bytes = ms.ToArray();" + nl + nl
                + "    if (QrImageDecoder.TryDecodeImage(bytes, out var decoded))" + nl
                + "    {" + nl
                + "        DecodedText = decoded.Text;" + nl
                + "    }" + nl
                + "    else" + nl
                + "    {" + nl
                + "        DecodedText = \"No code found in image\";" + nl
                + "    }" + nl
                + "}";
        }

        var category = Host?.SelectedCategory ?? "QR";

        if (category == "QR" || category == "SpecialQR")
        {
            return "// .NET MAUI - Display QR code in Image control" + nl
                + "using CodeGlyphX;" + nl
                + "using CodeGlyphX.Rendering;" + nl + nl
                + "// In your ViewModel or code-behind:" + nl
                + "var png = QR.Render(\"" + EscapeForComment(Host?.Content ?? "https://example.com") + "\", OutputFormat.Png).ToArray();" + nl
                + "QrImage.Source = ImageSource.FromStream(() => new MemoryStream(png));" + nl + nl
                + "// XAML:" + nl
                + "// <Image x:Name=\"QrImage\" WidthRequest=\"200\" HeightRequest=\"200\" />";
        }
        else if (category == "Barcode")
        {
            return "// .NET MAUI - Display barcode in Image control" + nl
                + "using CodeGlyphX;" + nl
                + "using CodeGlyphX.Rendering;" + nl + nl
                + "// In your ViewModel or code-behind:" + nl
                + "var png = Barcode.Render(SymbolFormat." + (Host?.GetBarcodeTypeEnumName() ?? "Code128") + ", \"" + EscapeForComment(Host?.BarcodeContent ?? "12345") + "\", OutputFormat.Png).ToArray();" + nl
                + "BarcodeImage.Source = ImageSource.FromStream(() => new MemoryStream(png));" + nl + nl
                + "// XAML:" + nl
                + "// <Image x:Name=\"BarcodeImage\" WidthRequest=\"300\" HeightRequest=\"100\" />";
        }
        else
        {
            var method = Host?.SelectedMatrixType switch
            {
                "Pdf417" => "Pdf417Code",
                "Aztec" => "AztecCode",
                _ => "DataMatrixCode"
            };
            return "// .NET MAUI - Display matrix code in Image control" + nl
                + "using CodeGlyphX;" + nl
                + "using CodeGlyphX.Rendering;" + nl + nl
                + "// In your ViewModel or code-behind:" + nl
                + "var png = " + method + ".Render(\"" + EscapeForComment(Host?.MatrixContent ?? "Data") + "\", OutputFormat.Png).ToArray();" + nl
                + "MatrixImage.Source = ImageSource.FromStream(() => new MemoryStream(png));" + nl + nl
                + "// XAML:" + nl
                + "// <Image x:Name=\"MatrixImage\" WidthRequest=\"200\" HeightRequest=\"200\" />";
        }
    }

    private string GetAspNetExampleVb()
    {
        var nl = "\n";
        var category = Host?.SelectedCategory ?? "QR";

        if (category == "QR" || category == "SpecialQR")
        {
            return "' ASP.NET Core Controller example" + nl
                + "Imports CodeGlyphX" + nl
                + "Imports CodeGlyphX.Rendering" + nl
                + "Imports Microsoft.AspNetCore.Mvc" + nl + nl
                + "Public Class QrController" + nl
                + "    Inherits ControllerBase" + nl + nl
                + "    <HttpGet(\"qr/{text}\")>" + nl
                + "    Public Function GetQrCode(text As String) As IActionResult" + nl
                + "        Dim png = QrCodeEncoder.EncodeText(text).Render(OutputFormat.Png).ToArray()" + nl
                + "        Return File(png, \"image/png\", \"qrcode.png\")" + nl
                + "    End Function" + nl
                + "End Class";
        }
        else if (category == "Barcode")
        {
            return "' ASP.NET Core Controller example" + nl
                + "Imports CodeGlyphX" + nl
                + "Imports CodeGlyphX.Rendering" + nl
                + "Imports Microsoft.AspNetCore.Mvc" + nl + nl
                + "Public Class BarcodeController" + nl
                + "    Inherits ControllerBase" + nl + nl
                + "    <HttpGet(\"barcode/{text}\")>" + nl
                + "    Public Function GetBarcode(text As String) As IActionResult" + nl
                + "        Dim png = Barcode.Render(SymbolFormat." + (Host?.GetBarcodeTypeEnumName() ?? "Code128") + ", text, OutputFormat.Png).ToArray()" + nl
                + "        Return File(png, \"image/png\", \"barcode.png\")" + nl
                + "    End Function" + nl
                + "End Class";
        }
        else
        {
            var method = Host?.SelectedMatrixType switch
            {
                "Pdf417" => "Pdf417Code",
                "Aztec" => "AztecCode",
                _ => "DataMatrixCode"
            };
            return "' ASP.NET Core Controller example" + nl
                + "Imports CodeGlyphX" + nl
                + "Imports CodeGlyphX.Rendering" + nl
                + "Imports Microsoft.AspNetCore.Mvc" + nl + nl
                + "Public Class MatrixController" + nl
                + "    Inherits ControllerBase" + nl + nl
                + "    <HttpGet(\"matrix/{text}\")>" + nl
                + "    Public Function GetMatrix(text As String) As IActionResult" + nl
                + "        Dim png = " + method + ".Render(text, OutputFormat.Png).ToArray()" + nl
                + "        Return File(png, \"image/png\", \"matrix.png\")" + nl
                + "    End Function" + nl
                + "End Class";
        }
    }

    private string GetMauiExampleVb()
    {
        var nl = "\n";
        var category = Host?.SelectedCategory ?? "QR";

        if (category == "QR" || category == "SpecialQR")
        {
            return "' .NET MAUI - Display QR code in Image control" + nl
                + "Imports CodeGlyphX" + nl
                + "Imports CodeGlyphX.Rendering" + nl
                + "Imports System.IO" + nl + nl
                + "' In your ViewModel or code-behind:" + nl
                + "Dim png = QrCodeEncoder.EncodeText(\"" + EscapeForVbString(Host?.Content ?? "https://example.com") + "\").Render(OutputFormat.Png).ToArray()" + nl
                + "QrImage.Source = ImageSource.FromStream(Function() New MemoryStream(png))" + nl + nl
                + "' XAML:" + nl
                + "' <Image x:Name=\"QrImage\" WidthRequest=\"200\" HeightRequest=\"200\" />";
        }
        else if (category == "Barcode")
        {
            return "' .NET MAUI - Display barcode in Image control" + nl
                + "Imports CodeGlyphX" + nl
                + "Imports CodeGlyphX.Rendering" + nl
                + "Imports System.IO" + nl + nl
                + "' In your ViewModel or code-behind:" + nl
                + "Dim png = Barcode.Render(SymbolFormat." + (Host?.GetBarcodeTypeEnumName() ?? "Code128") + ", \"" + EscapeForVbString(Host?.BarcodeContent ?? "12345") + "\", OutputFormat.Png).ToArray()" + nl
                + "BarcodeImage.Source = ImageSource.FromStream(Function() New MemoryStream(png))" + nl + nl
                + "' XAML:" + nl
                + "' <Image x:Name=\"BarcodeImage\" WidthRequest=\"300\" HeightRequest=\"100\" />";
        }
        else
        {
            var method = Host?.SelectedMatrixType switch
            {
                "Pdf417" => "Pdf417Code",
                "Aztec" => "AztecCode",
                _ => "DataMatrixCode"
            };
            return "' .NET MAUI - Display matrix code in Image control" + nl
                + "Imports CodeGlyphX" + nl
                + "Imports CodeGlyphX.Rendering" + nl
                + "Imports System.IO" + nl + nl
                + "' In your ViewModel or code-behind:" + nl
                + "Dim png = " + method + ".Render(\"" + EscapeForVbString(Host?.MatrixContent ?? "Data") + "\", OutputFormat.Png).ToArray()" + nl
                + "MatrixImage.Source = ImageSource.FromStream(Function() New MemoryStream(png))" + nl + nl
                + "' XAML:" + nl
                + "' <Image x:Name=\"MatrixImage\" WidthRequest=\"200\" HeightRequest=\"200\" />";
        }
    }

    private string GetLanguageCssClass()
    {
        if (IsPowerShell) return "language-powershell";

        if (Host?.SelectedMode == "Decode")
        {
            return SelectedLanguage == Playground.CodeLanguage.Vb ? "language-vbnet" : "language-csharp";
        }

        if (SelectedPlatform == "Blazor" && SelectedLanguage == Playground.CodeLanguage.Vb)
        {
            return "language-csharp";
        }

        return SelectedLanguage == Playground.CodeLanguage.Vb ? "language-vbnet" : "language-csharp";
    }

    private static string EscapeForComment(string s) => Playground.EscapeString(s);

    private static string EscapeForVbString(string s) => s.Replace("\"", "\"\"");
}
