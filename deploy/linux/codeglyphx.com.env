SITE_ROOT=/var/www/codeglyphx/com
PUBLIC_URL=https://codeglyphx.com
ORIGIN_HOST=codeglyphx.com
ORIGIN_ADDRESS=127.0.0.1
RELEASES_TO_KEEP=5
SMOKE_PATHS="/ /docs/ /api/ /playground/ /sitemap.xml"

# The root-owned token is captured in the encrypted server recovery backup.
# The legacy protected workflow may still supply an ephemeral token during cutover.
CLOUDFLARE_PURGE_ENABLED=1
CLOUDFLARE_ZONE_ID=75361cf864c5aa505f9fe8f023f14542
CLOUDFLARE_API_TOKEN_FILE=/etc/powerforge/secrets/codeglyphx-cloudflare-purge.token
