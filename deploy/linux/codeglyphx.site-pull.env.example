# Install root-owned at /etc/powerforge/site-pull/codeglyphx.com.env (mode 0644).
# The deployment service reads this file; it contains no secrets.
SOURCE_REPOSITORY=https://github.com/EvotecIT/CodeGlyphX.git
SOURCE_NAME=EvotecIT/CodeGlyphX
SOURCE_BRANCH=master
WEBSITE_DIRECTORY=Website
PIPELINE_CONFIG=pipeline.json
DOTNET_ROOT=/opt/powerforge-dotnet
DOTNET_RUNTIME_CHANNELS="8.0"
ENGINE_REPOSITORY_PATH=/srv/evotec/PSPublishModule
ENGINE_SHA=50e9c110e0a38ae4ccd80369959a4b32ca52191a
WORK_ROOT=/home/powerforge-codeglyphx/site-pull
CURRENT_LINK=/var/www/codeglyphx/com/current
PUBLIC_URL=https://codeglyphx.com
SMOKE_PATHS="/ /docs/ /api/ /playground/ /sitemap.xml"
