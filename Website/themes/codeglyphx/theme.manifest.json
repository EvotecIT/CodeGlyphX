{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/schemas/powerforge.web.themespec.schema.json",
  "schemaVersion": 2,
  "contractVersion": 2,
  "name": "codeglyphx",
  "engine": "scriban",
  "extends": "nova",
  "scriptsPath": "scripts",
  "features": ["docs", "apiDocs", "search", "notFound"],
  "slots": {
    "header": "header",
    "footer": "footer",
    "api-header": "api-header",
    "api-footer": "api-footer",
    "docs-sidebar": "docs-sidebar",
    "theme-tokens": "theme-tokens"
  },
  "featureContracts": {
    "apiDocs": {
      "requiredPartials": ["api-header", "api-footer", "theme-tokens"],
      "cssHrefs": ["/css/app.css", "/css/prism-theme.css", "/css/api.css"],
      "requiredCssSelectors": [
        ".api-layout",
        ".api-sidebar",
        ".api-content",
        ".sidebar-toggle",
        ".type-item",
        ".filter-button",
        ".member-card",
        ".member-signature"
      ]
    },
    "docs": {
      "requiredLayouts": ["docs"],
      "requiredPartials": ["header", "footer", "docs-sidebar", "theme-tokens"],
      "cssHrefs": ["/css/app.css", "/css/prism-theme.css"],
      "requiredCssSelectors": [".docs-layout"]
    },
    "notFound": {
      "requiredSurfaces": ["notFound"]
    }
  },
  "tokens": {
    "color": {
      "bg": "#0b0b12",
      "panel": "#13121b",
      "ink": "#f4f2fa",
      "muted": "#bcb7cc",
      "accent": "#8b5cf6",
      "accent2": "#67e8f9",
      "border": "#25232f"
    },
    "radius": {
      "base": "14px",
      "sm": "10px"
    },
    "layout": {
      "maxWidth": "1240px"
    },
    "font": {
      "body": "Inter, Segoe UI, sans-serif",
      "display": "Unbounded, Inter, sans-serif",
      "mono": "JetBrains Mono, Consolas, monospace"
    }
  }
}
